[sdl]
fullscreen=false
# fullresolution=3840x2160
windowresolution=2500x1800
output=openglnb

[dosbox]
machine=vgaonly
#vertical retrace poll debug line=true

[mixer]
nosound=false

[render]
aspect=true
# glshader = /usr/share/dosbox-x/glshaders/crt-lottes.glsl

[cpu]
core=auto
cputype=8086
cycles=fixed 30000
cycleup=10
cycledown=20
fpu=false

[joystick]
joysticktype=auto

[autoexec]
# Lines in this section will be run at startup.
# You can put your MOUNT lines here.

